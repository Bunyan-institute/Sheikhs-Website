# Admin login (required in production; development falls back to admin / sheikh_admin_2026!)
ADMIN_USERNAME=admin
# Generate with: node scripts/hash-password.mjs "your password"
ADMIN_PASSWORD_HASH=
# Alternative to the hash (less safe): ADMIN_PASSWORD=
# 16+ random characters used to sign admin session cookies (required in production)
ADMIN_SESSION_SECRET=
# Signs certificate verification tokens
CERTIFICATE_SECRET=

# Database: defaults to ./data/sheikh_ferej.db. Point at remote libSQL/Turso instead if desired.
# DATABASE_URL=file:/app/data/sheikh_ferej.db
# DATABASE_AUTH_TOKEN=

# Uploaded files directory (defaults to ./data/uploads)
# UPLOAD_DIR=/app/data/uploads
