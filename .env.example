# Admin login (required in production; development falls back to admin / sheikh_admin_2026!)
ADMIN_USERNAME=admin
# Generate with: node scripts/hash-password.mjs "your password"
ADMIN_PASSWORD_HASH=
# Alternative to the hash (less safe): ADMIN_PASSWORD=
# 16+ random characters used to sign admin session cookies (required in production)
ADMIN_SESSION_SECRET=
# Signs certificate verification tokens
CERTIFICATE_SECRET=

# Database. Default: SQLite at ./data/sheikh_ferej.db.
# Supabase / any Postgres (recommended on Vercel, which has no persistent disk) — use the pooled connection string:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# Remote libSQL/Turso also works (libsql://… plus DATABASE_AUTH_TOKEN).
# DATABASE_URL=file:/app/data/sheikh_ferej.db
# DATABASE_AUTH_TOKEN=

# Uploads: on Vercel + Postgres files are stored in the database (max MAX_UPLOAD_MB, default 4 because of the
# platform request-size limit). Elsewhere they go to UPLOAD_DIR (default ./data/uploads).
# UPLOAD_STORAGE=database | filesystem
# UPLOAD_DIR=/app/data/uploads

# Push notifications for the installed admin app. Generate once with `npm run vapid` and keep them
# (changing them cancels every subscribed device).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://your-domain.example
